<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows TFM copied from the monolith: WGC capture, Windows OCR and the low-level
       keyboard hook all stay on this side of the boundary. Plugins are plain net10.0. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Ocrx.Engine</RootNamespace>
    <!-- Tray icon (Ocrx.Engine.Tray) hosts a WinForms NotifyIcon in-process. Normal launches
         are tray-only; Program allocates a console when a debugger is attached. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Explorer/taskbar icon for Ocrx.Engine.exe itself, distinct from the runtime tray icon
         drawn by TrayIconFactory. Regenerate via scripts/generate_app_icon.py. -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Hosts gRPC on Kestrel without switching to the Web SDK, which would drag in the whole
       web app model (static files, routing conventions) for one named-pipe endpoint. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The private engine consumes the released public contract. There are no cross-repository
       project references: release and CI exercise the same package boundary as plugins. -->
  <ItemGroup>
    <PackageReference Include="Ocrx.Contracts" Version="2.0.0" />
  </ItemGroup>

  <!-- Static UI assets served by the control API (TASK-UI-03) from the same origin as /api/*.
       Copied so ControlApi.Map can find them next to the built exe; a test host's own output
       directory never gets this, and ControlApi.Map skips static-file serving entirely when the
       folder is absent. -->
  <ItemGroup>
    <Content Include="ui\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ocrx.Engine.Tests" />
    <InternalsVisibleTo Include="Ocrx.Engine.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <!-- Hosts the main window's client area (Shell/MainWindow.cs, TASK-UI-04). The only new dependency
         in the WebView2-window redesign — everything else it needed (the control API, the token,
         the loopback port) already existed from TASK-UI-03. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Installer/update runtime for the Velopack Setup.exe cut by release.yml. Pinned to the same
         version as the `vpk` local tool in .config/dotnet-tools.json: Velopack warns at pack time
         when the CLI and the SDK disagree, so the two move together or not at all. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- System.Diagnostics.PerformanceCounter (used by Metrics/MetricsSampler) is provided by the
         Windows Desktop framework that UseWindowsForms pulls in, so an explicit reference now trips
         NU1510 (redundant, un-prunable). The MetricsSampler types resolve from that framework. -->
  </ItemGroup>

</Project>
