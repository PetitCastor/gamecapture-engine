<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows TFM copied from the monolith: WGC capture, Windows OCR and the low-level
       keyboard hook all stay on this side of the boundary. Plugins are plain net10.0. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GameCapture.Engine</RootNamespace>
    <!-- Tray icon (GameCapture.Engine.Tray) hosts a WinForms NotifyIcon in-process. Normal launches
         are tray-only; Program allocates a console when a debugger is attached. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Explorer/taskbar icon for GameCapture.Engine.exe itself, distinct from the runtime tray icon
         drawn by TrayIconFactory. Regenerate via scripts/generate_app_icon.py. -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Hosts gRPC on Kestrel without switching to the Web SDK, which would drag in the whole
       web app model (static files, routing conventions) for one named-pipe endpoint. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Contracts only. The engine deliberately does NOT reference GameCapture.Sdk: the dependency arrow
       runs SDK -> contracts, and after the repo split (SOW-10/11) the SDK is a package published
       FROM here. That is why Operations/ConsoleSink.cs is a fork rather than a shared type. -->
  <ItemGroup>
    <ProjectReference Include="..\GameCapture.Contracts\GameCapture.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameCapture.Engine.Tests" />
    <InternalsVisibleTo Include="GameCapture.Engine.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <!-- Installer/update runtime for the Velopack Setup.exe cut by release.yml. Pinned to the same
         version as the `vpk` local tool in .config/dotnet-tools.json: Velopack warns at pack time
         when the CLI and the SDK disagree, so the two move together or not at all. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- System.Diagnostics.PerformanceCounter (used by Metrics/MetricsSampler) is provided by the
         Windows Desktop framework that UseWindowsForms pulls in, so an explicit reference now trips
         NU1510 (redundant, un-prunable). The MetricsSampler types resolve from that framework. -->
  </ItemGroup>

</Project>
